{
  "name": "dave-liddament/php-language-extensions",
  "description": "Attributes for extending the PHP language, using static analysis to enforce new language constructs",
  "keywords": [
    "static analysis",
    "package attribute",
    "friend attribute",
    "sealed attribute"
  ],
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Dave Liddament",
      "email": "dave@lampbristol.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "DaveLiddament\\PhpLanguageExtensions\\": "src/"
    }
  },
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3.5",
    "friendsofphp/php-cs-fixer": "^3.95.29",
    "php-parallel-lint/php-parallel-lint": "^1.4"
  },
  "scripts": {
    "composer-validate": "@composer validate --no-check-all --strict",
    "cs-fix": "php-cs-fixer fix",
    "cs": "php-cs-fixer fix --dry-run -v",
    "phpstan": "phpstan analyse",
    "lint": "parallel-lint src",
    "ci": [
      "@composer-validate",
      "@lint",
      "@cs",
      "@phpstan"
    ]
  }
}
